# Allow system_app to call HALs for hardware diagnostics/tests
binder_call(system_app, hal_audio_default)
binder_call(system_app, hal_bootctl_default)
binder_call(system_app, hal_drm_default)
binder_call(system_app, hal_fingerprint_default)
binder_call(system_app, hal_gatekeeper_default)
binder_call(system_app, hal_gnss_default)
binder_call(system_app, hal_graphics_composer_default)
binder_call(system_app, hal_health_default)
binder_call(system_app, hal_ir_default)
binder_call(system_app, hal_keymint_default)
binder_call(system_app, hal_light_default)
binder_call(system_app, hal_memtrack_default)
binder_call(system_app, hal_nfc_default)
binder_call(system_app, hal_power_default)
binder_call(system_app, hal_secure_element_default)
binder_call(system_app, hal_sensors_default)
binder_call(system_app, hal_thermal_default)
binder_call(system_app, hal_usb_default)
binder_call(system_app, hal_usb_gadget_default)
binder_call(system_app, hal_vibrator_default)
binder_call(system_app, mtk_hal_bluetooth)
binder_call(system_app, mtk_hal_c2)
binder_call(system_app, mtk_hal_camera)
binder_call(system_app, mtk_hal_secure_element)
binder_call(system_app, mtk_hal_usb)
binder_call(system_app, mtk_hal_videotelephony)

